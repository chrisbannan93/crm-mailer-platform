# Runtime
NODE_ENV=development
PORT=4010
VERTICAL=generic

# Connector security
WEBHOOK_SHARED_SECRET=change_me
TWENTY_WEBHOOK_SECRET=change_me_optional
TRACKING_SIGNING_SECRET=change_me

# Twenty CRM
TWENTY_BASE_URL=http://localhost:3000
TWENTY_API_KEY=
TWENTY_GRAPHQL_PATH=/graphql
TWENTY_REST_PATH=/rest
TWENTY_WRITEBACK_MODE=log
TWENTY_ENGAGEMENT_NOTE_ENDPOINT=/rest/notes

# listmonk
LISTMONK_BASE_URL=http://localhost:9000
LISTMONK_API_USER=admin
LISTMONK_API_PASSWORD=admin_change_me
LISTMONK_DEFAULT_LIST_ID=1

# Tracking URLs in email templates should point here
PUBLIC_TRACKING_BASE_URL=http://localhost:4010

# Local mail viewer (optional)
MAILPIT_BASE_URL=http://localhost:8025
